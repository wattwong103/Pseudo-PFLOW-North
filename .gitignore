# Pseudo-PFLOW .gitignore

# ── Java & native build outputs ─────────────────────────
target/
bin/
bin_fresh/
build/
out/
*.class
*.jar
!lib/osmpbf-1.3.3.jar
osmpbf-*.jar

# ── Simulation data & outputs (local-only, regenerable) ─
output/
data/
logs/
archive_local/
*.duckdb
*.duckdb.wal
*.bin
*.dat
*.raster
*.xlsx
src/scripts/**/*.csv
src/scripts/**/*.tsv

# ── Archives, backups, logs & temp files ────────────────
*.7z
*.rar
*.tar
*.tar.gz
*.zip
*.backup
*.bak
*.orig
*.rej
*.swp
*.tmp
*~
*edit-log.txt
*.log
hs_err_pid*
replay_pid*

# ── Machine-local configs & scratch runners ─────────────
config.local.properties
src/main/resources/config.local.properties
*.properties.test_*
_*.bat
_*.sh
compile_*_args.txt
compile_local.*

# ── Python & Jupyter ────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── Environment, OS & IDE ───────────────────────────────
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
.classpath
.classpath.txt
.factorypath
.mvn/
.project
.settings/
*.sublime-*

# ── Per-clone worktrees, caches & workspace tooling ─────
.worktrees/
/graft/
.ai-sdlc/
backlog/
.claude/
.codex/
.grok/
.agents/
.mavis/
.harness/
.cursor/
.aider*
openspec/
AGENTS.md
CLAUDE.md
.mcp.json
opencode.json
